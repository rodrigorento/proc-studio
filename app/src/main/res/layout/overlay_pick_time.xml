<?xml version="1.0" encoding="utf-8"?>
<!-- Pick a time: one tap on a quick choice and the feed comes back. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_scrim">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <Button
            android:id="@+id/btnPickBack"
            style="@style/ScrollGate.Button.Text"
            android:layout_marginStart="-8dp"
            android:drawableStart="@drawable/ic_back"
            android:text="@string/pick_back" />

        <TextView
            style="@style/ScrollGate.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="@string/pick_title"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvPickTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_surface"
            android:backgroundTint="@color/sg_surface_2"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_semibold"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:textColor="@color/sg_text_soft"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/timeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnCalendar"
            style="@style/ScrollGate.Button.Text"
            android:layout_marginTop="8dp"
            android:layout_marginStart="-8dp"
            android:text="@string/pick_calendar"
            android:textColor="@color/sg_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/pick_footnote"
            android:textColor="@color/sg_muted"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
