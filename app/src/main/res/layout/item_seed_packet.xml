<?xml version="1.0" encoding="utf-8"?>
<!-- One seed packet on the planting screen: the packet, the time it stands for, and the crop it grows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_packet"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/ivPacket"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvPacketWhen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/nunito_bold"
        android:gravity="center"
        android:textColor="@color/sg_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvPacketCrop"
        style="@style/ScrollGate.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/sg_muted" />
</LinearLayout>
