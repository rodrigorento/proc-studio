<?xml version="1.0" encoding="utf-8"?>
<!-- A rendered bed on an overlay screen: the bed, a second bed fading in over it (dry to wet, or ripening),
     and the frames of a watering, rain or harvest on top. See BedStack. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">

    <ImageView
        android:id="@+id/bedBase"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/bedTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/bedEffect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />
</FrameLayout>
