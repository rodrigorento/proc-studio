<?xml version="1.0" encoding="utf-8"?>
<!-- Planting, step 2 of the ask-for-tasks screen: four seeds, one per stretch of days. A picked seed moves up and
     opens its days on a calendar and a time; the time said in the task opens that way already. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/seedsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btnSeedsBack"
                style="@style/ScrollGate.Button.Text"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:drawableStart="@drawable/ic_back"
                android:text="@string/back" />

            <TextView
                android:id="@+id/tvSeedsTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_leaf"
                android:fontFamily="@font/nunito_bold"
                android:maxLines="2"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/sg_accent"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSeedsTitle"
                style="@style/ScrollGate.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityHeading="true"
                android:text="@string/plant_seeds_title"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvSeedsBody"
                style="@style/ScrollGate.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/plant_seeds_body"
                android:textSize="16sp" />

            <!-- Two rows of two seeds, filled in by GateOverlay; hidden once one is picked. -->
            <LinearLayout
                android:id="@+id/seedRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- The picked seed, where "You said" sits; Change brings the others back. -->
            <LinearLayout
                android:id="@+id/pickedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_packet"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivPickedPacket"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPickedEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extrabold"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="@color/sg_accent"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPickedCrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extrabold"
                        android:textColor="@color/sg_text"
                        android:textSize="19sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnChangeSeed"
                    style="@style/ScrollGate.Button.Text"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_change"
                    android:textColor="@color/sg_accent" />
            </LinearLayout>

            <!-- The seed's days: a month at a time, only its days open. -->
            <LinearLayout
                android:id="@+id/calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:fontFamily="@font/nunito_extrabold"
                        android:textColor="@color/sg_text"
                        android:textSize="17sp" />

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/plant_prev_month"
                        android:src="@drawable/ic_back"
                        android:tint="@color/sg_accent" />

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/plant_next_month"
                        android:scaleX="-1"
                        android:src="@drawable/ic_back"
                        android:tint="@color/sg_accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weekdays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/dayRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Any time that day, or a time set on Android's wheels. -->
            <LinearLayout
                android:id="@+id/timeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/plant_time"
                    android:textColor="@color/sg_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_extrabold"
                    android:textColor="@color/sg_text"
                    android:textSize="17sp" />

                <Switch
                    android:id="@+id/swTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/plant_set_time" />
            </LinearLayout>

            <include
                android:id="@+id/timeWheel"
                layout="@layout/view_time_wheel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRipeBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/sg_text_soft"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnPlant"
        style="@style/ScrollGate.Button.Primary"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp" />
</LinearLayout>
