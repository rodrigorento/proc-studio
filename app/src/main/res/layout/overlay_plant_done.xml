<?xml version="1.0" encoding="utf-8"?>
<!-- Planting, the last step of the ask-for-tasks screen: the seeds pour into the bed, then back to the feed or plant
     another. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <include
                android:id="@+id/bed"
                layout="@layout/view_bed"
                android:layout_width="260dp"
                android:layout_height="260dp" />

            <TextView
                android:id="@+id/tvPlantedTitle"
                style="@style/ScrollGate.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/planted_title"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvPlantedLine"
                style="@style/ScrollGate.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvPlantedWhen"
                style="@style/ScrollGate.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/sg_text_soft"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnPlantedScroll"
        style="@style/ScrollGate.Button.Primary"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="@color/sg_text"
        android:text="@string/add_start_scrolling" />

    <Button
        android:id="@+id/btnPlantAnother"
        style="@style/ScrollGate.Button.Secondary"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/plant_another" />
</LinearLayout>
