<?xml version="1.0" encoding="utf-8"?>
<!-- A task on the add-tasks screen: its time pill opens the time chips underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/sg_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvRowWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_surface"
            android:backgroundTint="@color/sg_surface_2"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito_semibold"
            android:minHeight="32dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/sg_text_soft"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnRemoveTask"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="-10dp"
            android:background="@drawable/bg_button_text"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="@color/sg_muted"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/whenChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/whenChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="10dp" />
    </HorizontalScrollView>
</LinearLayout>
