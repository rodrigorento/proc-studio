<?xml version="1.0" encoding="utf-8"?>
<!-- Shown instead of the gate while the list is empty: add tasks by voice, or type them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/ScrollGate.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/add_title"
                android:textSize="28sp" />

            <TextView
                style="@style/ScrollGate.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/add_subtitle"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/voiceBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_mic"
                    android:contentDescription="@string/add_mic"
                    android:padding="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/sg_on_accent" />

                <TextView
                    android:id="@+id/tvMicStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/add_mic_idle"
                    android:textColor="@color/sg_accent"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:lineSpacingMultiplier="1.2"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/sg_text_soft"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvListTitle"
                style="@style/ScrollGate.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true" />

            <LinearLayout
                android:id="@+id/taskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvListFull"
                style="@style/ScrollGate.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/add_list_full"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/typeBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ScrollGate.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/add_type_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNewTask"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:autofillHints=""
                        android:background="@drawable/bg_input"
                        android:hint="@string/add_type_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/sg_text"
                        android:textColorHint="@color/sg_faint"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnAddTyped"
                        style="@style/ScrollGate.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="52dp"
                        android:text="@string/add_button" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Outside the scroll view so it stays on screen, keyboard or not. -->
    <Button
        android:id="@+id/btnStartScrolling"
        style="@style/ScrollGate.Button.Primary"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/sg_text"
        android:text="@string/add_start_scrolling" />
</LinearLayout>
