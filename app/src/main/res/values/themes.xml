<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ProjDIIC" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sg_bg</item>
        <item name="android:colorBackground">@color/sg_bg</item>
        <item name="android:colorAccent">@color/sg_accent</item>
        <item name="android:textColorPrimary">@color/sg_text</item>
        <item name="android:textColorSecondary">@color/sg_muted</item>
    </style>

    <!-- Base for the overlay styles below; the dotted names inherit from it. -->
    <style name="ScrollGate" />

    <!-- Buttons on the overlay screens -->
    <style name="ScrollGate.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ScrollGate.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/sg_on_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScrollGate.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/sg_text</item>
    </style>

    <style name="ScrollGate.Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/sg_text_soft</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ScrollGate.Button.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/sg_text_soft</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:drawableTint">@color/sg_text_soft</item>
        <item name="android:drawablePadding">4dp</item>
    </style>

    <!-- Text on the overlay screens -->
    <style name="ScrollGate.Title">
        <item name="android:textColor">@color/sg_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="ScrollGate.Body">
        <item name="android:textColor">@color/sg_muted</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="ScrollGate.Small">
        <item name="android:textColor">@color/sg_faint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ScrollGate.Label">
        <item name="android:textColor">@color/sg_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
