<resources>
    <string name="app_name">Task Farm</string>
    <string name="accessibility_description">Counts your swipes in Instagram and, after a stretch of scrolling, pauses it to show the next thing growing in your field. It notices which app is open; it does not save what is on screen.</string>

    <!-- Gate: one crop and its ways out -->
    <string name="gate_feed_paused">Field break</string>
    <string-array name="gate_eyebrows">
        <item>Your field needs a hand</item>
        <item>Before the next video</item>
        <item>Still growing in your field</item>
        <item>One crop first</item>
    </string-array>
    <string name="gate_meta_added">Planted %1$s · %2$s</string>
    <string name="gate_meta_said">Said out loud %1$s · %2$s</string>
    <string name="gate_meta_snoozed">Back after its 5 minutes</string>
    <string name="gate_harvest">Harvest it</string>
    <string name="gate_water_it">Water it</string>
    <string name="gate_snooze">5 more minutes · once</string>
    <string name="gate_snooze_used">You\'ve had your 5 minutes for this one.</string>
    <string name="gate_hint">Pick one and the feed opens again.</string>
    <string name="day_today">today</string>
    <string name="day_yesterday">yesterday</string>

    <string name="toast_done">Harvested. It\'s off your field.</string>

    <!-- Trusted-person check-in -->
    <string name="check_in_title">This crop keeps waiting</string>
    <string name="check_in_body">You\'ve walked past “%1$s” twice. You asked %2$s to check in when that happens.</string>
    <string name="check_in_who">The note in %1$s\'s mailbox</string>
    <string name="check_in_message">“Could you check in about: %1$s?”</string>
    <string name="check_in_privacy">Only the task\'s name. Nothing about your scrolling.</string>
    <string name="check_in_ok">Send %1$s the note</string>
    <string name="check_in_off">Stop the notes</string>
    <string name="trusted_person_fallback">your trusted person</string>
    <string name="toast_check_in">Okay. We\'ll get the note to %1$s.</string>

    <!-- Add tasks -->
    <string name="add_voice_retry">Didn\'t catch that. Try again, or type it.</string>
    <string name="toast_app_snoozed">Gate closed until tomorrow.</string>


