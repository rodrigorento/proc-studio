<resources>
    <string name="app_name">Task Farm</string>
    <string name="accessibility_description">Counts your swipes in Instagram and, after a stretch of scrolling, pauses it to show the next thing growing in your field. It notices which app is open; it does not save what is on screen.</string>

    <!-- Gate: one crop and its ways out -->
    <string name="gate_feed_paused">Field break</string>
    <string-array name="gate_eyebrows">
        <item>Your field needs a hand</item>
        <item>Before the next video</item>
        <item>Still growing in your field</item>
        <item>One crop first</item>
    </string-array>
